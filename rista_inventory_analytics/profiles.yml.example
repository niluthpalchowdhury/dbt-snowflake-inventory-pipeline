# dbt connection profile. Copy it to where dbt looks for it:
#
#   cp rista_inventory_analytics/profiles.yml.example ~/.dbt/profiles.yml
#
# Nothing here is a literal value - every field reads from the environment, so
# the filled-in copy is still safe to look at and there is no credential to
# accidentally commit. The variable names line up with .env.example.
#
# The profile name has to match `profile:` in dbt_project.yml, and the schema
# set here is only a default: the bronze / silver / gold layers each override
# it from the models: block in dbt_project.yml.

rista_inventory_analytics:
  target: dev

  outputs:
    dev:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"        # e.g. myorg-myaccount
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      password: "{{ env_var('SNOWFLAKE_PASSWORD') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE') }}"              # e.g. TRANSFORMER
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"    # e.g. TRANSFORM_WH
      database: "{{ env_var('SNOWFLAKE_DATABASE') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA') }}"
      threads: 8
      client_session_keep_alive: false

    # Same connection, different auth. Scheduled runs have nobody around to
    # type a password, and a key can be rotated without touching the user.
    prod:
      type: snowflake
      account: "{{ env_var('SNOWFLAKE_ACCOUNT') }}"
      user: "{{ env_var('SNOWFLAKE_USER') }}"
      role: "{{ env_var('SNOWFLAKE_ROLE') }}"
      warehouse: "{{ env_var('SNOWFLAKE_WAREHOUSE') }}"
      database: "{{ env_var('SNOWFLAKE_DATABASE') }}"
      schema: "{{ env_var('SNOWFLAKE_SCHEMA') }}"
      threads: 8

      # Use these instead of `password:` - not alongside it.
      private_key_path: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PATH') }}"
      private_key_passphrase: "{{ env_var('SNOWFLAKE_PRIVATE_KEY_PASSPHRASE') }}"
