# Copy to .env and fill in. .env is gitignored - never commit a filled-in copy.
#
#   cp .env.example .env
#
# Placeholders in <angle brackets> are required. Everything else has a sane
# default and can be left as-is.

# ---- Runtime ------------------------------------------------------------
DAYS_BACK=5                     # rolling window size when no explicit dates are passed
EXCLUDE_TODAY=true              # today is still accumulating activity; skip it
TIMEZONE=UTC                    # IANA name. Defines the business date boundary.
MAX_WORKERS=6                   # concurrent branch fetches
REQUEST_TIMEOUT_SECONDS=120
RISTA_MAX_RETRIES=5             # transport-level retries on 429/5xx
MAX_FAILURE_PERCENT=10          # abort the load above this branch failure rate

# ---- Rista API ----------------------------------------------------------
RISTA_API_KEY=<your-api-key>
RISTA_API_SECRET=<your-api-secret>
RISTA_API_BASE_URL=https://api.example-pos.com/v1

# ---- Azure Blob Storage (landing zone) ----------------------------------
LOAD_TO_AZURE=true
AZURE_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net
AZURE_SAS_TOKEN=<container-scoped-sas-token>    # write+delete on the container; prefer a short expiry
AZURE_CONTAINER=<container-name>
AZURE_DIRECTORY=Item_Balance_Activity_Cost      # blob prefix for the partitions

# ---- Snowflake (read by profiles.yml via env_var) -----------------------
SNOWFLAKE_ACCOUNT=<org-account>                 # e.g. myorg-myaccount
SNOWFLAKE_USER=<username>
SNOWFLAKE_PASSWORD=<password>
SNOWFLAKE_ROLE=<role>                           # e.g. TRANSFORMER
SNOWFLAKE_WAREHOUSE=<warehouse>                 # e.g. TRANSFORM_WH
SNOWFLAKE_DATABASE=<database>                   # target db for built models
SNOWFLAKE_SCHEMA=<schema>                       # default schema

# Key-pair auth instead of a password (recommended for scheduled runs):
# SNOWFLAKE_PRIVATE_KEY_PATH=<path-to-rsa_key.p8>
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>
