# Copy this to .env and fill it in:
#
#   cp .env.example .env
#
# .env is gitignored. Never commit a filled-in copy, and if you ever think you
# might have, rotate the credentials rather than deleting the file - git keeps
# it either way.
#
# Anything in <angle brackets> you have to supply. Everything else already has
# a working default and can be left alone until you have a reason to change it.

# ---- Runtime ------------------------------------------------------------
# Five days back is a deliberate over-fetch. The source restates recent days as
# corrections come in, so re-pulling a window that has already loaded is how
# those corrections reach the warehouse. Re-runs are idempotent, so this is
# cheap insurance rather than wasted work.
DAYS_BACK=5

# Today is still accumulating activity - a store that closes at midnight has
# not finished selling yet. Pulling it gives you a half-day that looks like a
# collapse in sales. Leave this on.
EXCLUDE_TODAY=true

# IANA timezone name. This decides where the business date boundary falls, so
# it should match how the business reports its day, not where the server is.
TIMEZONE=UTC

# Concurrent store fetches. Going much higher mostly earns you 429s.
MAX_WORKERS=6
REQUEST_TIMEOUT_SECONDS=120

# Transport-level retries on 429 and 5xx, with backoff. These are silent - the
# calling code never sees a retried request.
RISTA_MAX_RETRIES=5

# The circuit breaker. The load replaces whole date partitions, so a run that
# only half-succeeded would overwrite a complete day with an incomplete one and
# look perfectly healthy doing it. Above this failure rate the run aborts
# before writing anything and yesterday's data survives.
MAX_FAILURE_PERCENT=10

# ---- Rista API ----------------------------------------------------------
# The key is sent as a header and also signs a short-lived JWT with the secret.
# Both are needed.
RISTA_API_KEY=<your-api-key>
RISTA_API_SECRET=<your-api-secret>
RISTA_API_BASE_URL=https://api.example-pos.com/v1

# ---- Azure Blob Storage (landing zone) ----------------------------------
LOAD_TO_AZURE=true
AZURE_ACCOUNT_URL=https://<storage-account-name>.blob.core.windows.net

# Needs write and delete on the container - delete because each run removes the
# old partition before writing the new one. Scope it to the single container
# and give it the shortest expiry you can live with.
AZURE_SAS_TOKEN=<container-scoped-sas-token>

AZURE_CONTAINER=<container-name>

# Blob prefix the date partitions are written under. Change it and the Snowflake
# stage in snowflake/raw_ingestion.sql has to change to match.
AZURE_DIRECTORY=Item_Balance_Activity_Cost

# ---- Snowflake ----------------------------------------------------------
# Not read by main.py - these are here because profiles.yml pulls them in with
# env_var(), which keeps the connection details out of any file git can see.
SNOWFLAKE_ACCOUNT=<org-account>                 # e.g. myorg-myaccount
SNOWFLAKE_USER=<username>
SNOWFLAKE_PASSWORD=<password>
SNOWFLAKE_ROLE=<role>                           # e.g. TRANSFORMER
SNOWFLAKE_WAREHOUSE=<warehouse>                 # e.g. TRANSFORM_WH
SNOWFLAKE_DATABASE=<database>                   # where the models get built
SNOWFLAKE_SCHEMA=<schema>                       # default; the layers override it

# For anything scheduled, use key-pair auth instead of the password above. No
# interactive prompt, and the key rotates independently of the user account.
# SNOWFLAKE_PRIVATE_KEY_PATH=<path-to-rsa_key.p8>
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=<passphrase>
